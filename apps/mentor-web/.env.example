# Local Next.js development (npm run dev, port 3003).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cloudflare Builds: set NEXT_PUBLIC_API_URL in the BUILD environment to the
# existing deployed FastAPI HTTPS URL used by Fellow/Admin. Do not use the
# local value above in production. This public value is embedded at build time.
# Do not put backend secrets or Cloudflare tokens in NEXT_PUBLIC_* variables.
